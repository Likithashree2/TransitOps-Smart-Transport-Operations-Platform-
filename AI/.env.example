# Existing core backend already has DATABASE_URL etc. This module reuses the same DB.
DATABASE_URL="postgresql://user:password@localhost:5432/transitops"

# LLM Dispatch Copilot
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"          # gpt-4o also fine; mini is cheaper/faster for tool-calling loops

# Fuel Anomaly Detection (Isolation Forest)
FUEL_ANOMALY_CONTAMINATION=0.05     # expected fraction of anomalous fuel logs per vehicle
FUEL_ANOMALY_TREES=100
FUEL_ANOMALY_SUBSAMPLE=64
FUEL_ANOMALY_JOB_INTERVAL_SEC=45    # scheduled job cadence

# Maintenance Risk Score (Random Forest)
MAINT_RISK_TREES=80
MAINT_RISK_JOB_ENABLED=true

# Server
PORT=4001
